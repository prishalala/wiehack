# Frontend (Vite) — safe to expose; use the publishable/anon key only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Edge Function secrets (set with `npx supabase secrets set`, NOT in Vite)
# Free (recommended): Groq — https://console.groq.com/keys
#   npx supabase secrets set GROQ_API_KEY=gsk_...
#   npx supabase secrets set AI_MODEL=openai/gpt-oss-20b
# Or Lovable gateway (uses Lovable credits):
#   npx supabase secrets set LOVABLE_API_KEY=...
#   npx supabase secrets set AI_MODEL=google/gemini-2.5-flash
